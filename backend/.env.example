# Copy to .env for local overrides (never commit .env). All values are optional.
# Load with: uvicorn app.main:app --reload --env-file .env

# development | production
VOUCH_ENV=development
# DEBUG | INFO | WARNING | ERROR
VOUCH_LOG_LEVEL=INFO
# Comma-separated explicit origins; '*' is rejected.
VOUCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Local development only -------------------------------------------------
# Enables POST/GET /api/dev/events (in-memory test events for the extension).
# Off unless set to true; refused at startup unless VOUCH_ENV=development.
VOUCH_ENABLE_DEV_ENDPOINTS=false
# Exact Chrome extension origins allowed by CORS while dev endpoints are on.
# Only needed if the extension has no host_permissions for http://127.0.0.1:8000/*.
# Comma-separated; wildcards rejected. Example:
# VOUCH_EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
VOUCH_EXTENSION_ORIGINS=

# --- Interview sessions (Milestone 4, development mode only) -----------------
# SQLAlchemy URL. Default: backend/data/vouch.db (gitignored). Example:
# VOUCH_DATABASE_URL=sqlite:////absolute/path/to/vouch.db
VOUCH_DATABASE_URL=
# Hours a candidate join code stays valid (1-720).
VOUCH_JOIN_CODE_TTL_HOURS=72
