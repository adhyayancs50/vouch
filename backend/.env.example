# Copy to .env for local overrides (never commit .env). All values are optional.
# Load with: uvicorn app.main:app --reload --env-file .env

# development | production
VOUCH_ENV=development
# DEBUG | INFO | WARNING | ERROR
VOUCH_LOG_LEVEL=INFO
# Comma-separated explicit origins; '*' is rejected.
VOUCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
